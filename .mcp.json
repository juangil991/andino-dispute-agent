{
  "mcpServers": {
    "core_banking_mcp": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "core_banking_mcp.server"],
      "env": {
        "CORE_DATABASE_URL": "${CORE_DATABASE_URL:-sqlite:///./data/core_banking.db}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,projects"
      }
    }
  }
}
